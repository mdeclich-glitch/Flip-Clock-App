{
  "name": "flip-clock-app",
  "version": "1.4.2",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "manifest": "node tools/make-manifest.js",
    "release": "node tools/release.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "liveUpdate": {
    "baseUrl": "https://raw.githubusercontent.com/mdeclich-glitch/Flip-Clock-App/main/"
  },
  "build": {
    "appId": "com.flipclock.app",
    "productName": "Flip Clock",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5"
  }
}
