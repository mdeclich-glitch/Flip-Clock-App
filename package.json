{
  "name": "flip-clock-app",
  "version": "1.5.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "manifest": "node tools/make-manifest.js",
    "release": "node tools/release.js",
    "pack": "electron-builder --dir",
    "saver": "electron . --screensaver",
    "stub": "(if not exist build mkdir build) && C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /nologo /target:winexe /out:build\\FlipClock.scr tools\\scr-stub.cs",
    "dist": "npm run stub && electron-builder"
  },
  "liveUpdate": {
    "baseUrl": "https://raw.githubusercontent.com/mdeclich-glitch/Flip-Clock-App/main/"
  },
  "build": {
    "appId": "com.flipclock.app",
    "productName": "Flip Clock",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "extraFiles": [
      {
        "from": "build/FlipClock.scr",
        "to": "FlipClock.scr"
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5"
  }
}
