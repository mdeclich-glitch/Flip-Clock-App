{
  "name": "flip-clock-screensaver",
  "version": "1.0.0",
  "description": "Flip Clock Screensaver per Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:scr": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.flipclock.screensaver",
    "productName": "FlipClock-Screensaver",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "FlipClock-Screensaver.scr"
    },
    "files": [
      "main.js",
      "screensaver.html",
      "index.html",
      "mini.html",
      "package.json"
    ]
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  }
}