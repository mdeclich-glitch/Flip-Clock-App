{
  "name": "flip-clock-app",
  "version": "1.8.1",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "manifest": "node tools/make-manifest.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "release": "electron-builder --publish always",
    "bump": "npm version patch --no-git-tag-version && npm run manifest",
    "bump:minor": "npm version minor --no-git-tag-version && npm run manifest"
  },
  "liveUpdate": {
    "baseUrl": "https://raw.githubusercontent.com/mdeclich-glitch/Flip-Clock-App/main/"
  },
  "build": {
    "appId": "com.flipclock.app",
    "productName": "Flip Clock",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "artifactName": "Flip-Clock-Setup-${version}.${ext}",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mdeclich-glitch",
        "repo": "Flip-Clock-App",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5"
  }
}
